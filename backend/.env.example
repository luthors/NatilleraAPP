# ─── Natillera App — Backend Environment Variables ────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Natillera API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development   # development | staging | production

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string-in-production

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── JWT ───────────────────────────────────────────────────────────────────────
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://natillera:natillera@localhost:5432/natillera_db
DATABASE_URL_TEST=sqlite:///./test.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:19006

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAILS_ENABLED=false          # Set to true in production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Natillera App"
SMTP_FROM_EMAIL=noreply@natillera.app

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=2

# ── Application URLs ──────────────────────────────────────────────────────────
# Used for links in emails and QR code verification
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
